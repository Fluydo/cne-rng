{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/banner.svg",
      "dest": "/banner.svg",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/nameplates_data.js",
      "dest": "/nameplates_data.js"
    },
    {
      "src": "/nameplates/(.*)",
      "dest": "/nameplates/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}