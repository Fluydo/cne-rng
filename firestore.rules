rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Fields: username, pfp, created_at, updated_at,
    //         bio, equipped_font, equipped_border, equipped_theme,
    //         name_font, avatar_border, profile_theme
    //
    // Collection: /game_states/{userId}
    // Fields: state_json, username, updated_at, total_rolls,
    //         coins, unique, best_pull_tier, title, title_class,
    //         equipped_title, equipped_title_class
    //
    // Collection: /leaderboard/{userId}
    // Fields: username, pfp, unique, total_rolls, best_pull_tier,
    //         coins, title, title_class, equipped_title,
    //         equipped_title_class, updated_at,
    //         bio, equipped_font, equipped_border, equipped_theme
    //
    // Collection: /live_feed/{feedId}
    // Fields: username, character, tier, timestamp, created_at, user_id
    //
    // ===============================================================

    // ===============================================================
    // Global Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isCreatedAtPreserved() {
      return !('created_at' in resource.data) ||
             !('created_at' in request.resource.data) ||
             request.resource.data.created_at == resource.data.created_at;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields([
                 'username', 'pfp', 'created_at', 'updated_at',
                 'bio', 'equipped_font', 'equipped_border', 'equipped_theme',
                 'name_font', 'avatar_border', 'profile_theme'
               ]) &&
             data.username is string &&
             data.username.size() >= 1 &&
             data.username.size() <= 64 &&
             (!('pfp' in data) || (data.pfp is string && data.pfp.size() <= 1000)) &&
             (!('created_at' in data) || data.created_at is timestamp) &&
             (!('updated_at' in data) || data.updated_at is timestamp) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('equipped_font' in data) || (data.equipped_font is string && data.equipped_font.size() <= 128)) &&
             (!('equipped_border' in data) || (data.equipped_border is string && data.equipped_border.size() <= 128)) &&
             (!('equipped_theme' in data) || (data.equipped_theme is string && data.equipped_theme.size() <= 128)) &&
             (!('name_font' in data) || (data.name_font is string && data.name_font.size() <= 128)) &&
             (!('avatar_border' in data) || (data.avatar_border is string && data.avatar_border.size() <= 128)) &&
             (!('profile_theme' in data) || (data.profile_theme is string && data.profile_theme.size() <= 128));
    }

    function isValidGameState(data) {
      return hasOnlyAllowedFields([
                 'state_json', 'username', 'updated_at', 'total_rolls',
                 'coins', 'unique', 'best_pull_tier', 'title', 'title_class',
                 'equipped_title', 'equipped_title_class'
               ]) &&
             hasRequiredFields(['state_json']) &&
             data.state_json is string &&
             data.state_json.size() >= 2 &&
             data.state_json.size() <= 500000 &&
             (!('username' in data) || (data.username is string && data.username.size() <= 64)) &&
             (!('updated_at' in data) || data.updated_at is timestamp) &&
             (!('total_rolls' in data) || (data.total_rolls is number && data.total_rolls >= 0)) &&
             (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
             (!('unique' in data) || (data.unique is number && data.unique >= 0)) &&
             (!('best_pull_tier' in data) || (data.best_pull_tier is string && data.best_pull_tier.size() <= 32)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 64)) &&
             (!('title_class' in data) || (data.title_class is string && data.title_class.size() <= 64)) &&
             (!('equipped_title' in data) || (data.equipped_title is string && data.equipped_title.size() <= 64)) &&
             (!('equipped_title_class' in data) || (data.equipped_title_class is string && data.equipped_title_class.size() <= 64));
    }

    function isValidLeaderboardEntry(data) {
      return hasOnlyAllowedFields([
                 'username', 'pfp', 'unique', 'total_rolls',
                 'best_pull_tier', 'coins', 'title', 'title_class',
                 'equipped_title', 'equipped_title_class', 'updated_at',
                 'bio', 'equipped_font', 'equipped_border', 'equipped_theme'
               ]) &&
             data.username is string &&
             data.username.size() >= 1 &&
             data.username.size() <= 64 &&
             (!('pfp' in data) || (data.pfp is string && data.pfp.size() <= 1000)) &&
             (!('unique' in data) || (data.unique is number && data.unique >= 0)) &&
             (!('total_rolls' in data) || (data.total_rolls is number && data.total_rolls >= 0)) &&
             (!('best_pull_tier' in data) || (data.best_pull_tier is string && data.best_pull_tier.size() <= 32)) &&
             (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 64)) &&
             (!('title_class' in data) || (data.title_class is string && data.title_class.size() <= 64)) &&
             (!('equipped_title' in data) || (data.equipped_title is string && data.equipped_title.size() <= 64)) &&
             (!('equipped_title_class' in data) || (data.equipped_title_class is string && data.equipped_title_class.size() <= 64)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('equipped_font' in data) || (data.equipped_font is string && data.equipped_font.size() <= 128)) &&
             (!('equipped_border' in data) || (data.equipped_border is string && data.equipped_border.size() <= 128)) &&
             (!('equipped_theme' in data) || (data.equipped_theme is string && data.equipped_theme.size() <= 128)) &&
             (!('updated_at' in data) || data.updated_at is timestamp);
    }

    function isValidFeedItem(data) {
      return hasOnlyAllowedFields(['username', 'character', 'tier', 'timestamp', 'created_at', 'user_id']) &&
             hasRequiredFields(['username', 'character', 'tier']) &&
             data.username is string &&
             data.username.size() >= 1 &&
             data.username.size() <= 64 &&
             data.character is string &&
             data.character.size() >= 1 &&
             data.character.size() <= 64 &&
             data.tier is string &&
             data.tier.size() >= 1 &&
             data.tier.size() <= 32 &&
             (!('timestamp' in data) || data.timestamp is timestamp) &&
             (!('created_at' in data) || data.created_at is timestamp) &&
             (!('user_id' in data) || (data.user_id is string && data.user_id == request.auth.uid));
    }

    // ===============================================================
    // Default Deny Root
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data) &&
                       isCreatedAtPreserved();
      allow delete: if false;
    }

    // 2. Game States
    match /game_states/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidGameState(request.resource.data);
      allow delete: if false;
    }

    // 3. Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidLeaderboardEntry(request.resource.data);
      allow delete: if false;
    }

    // 4. Live Feed
    match /live_feed/{feedId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidFeedItem(request.resource.data);
      allow update, delete: if false;
    }
  }
}
